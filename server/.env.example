# Server environment example
# Copy to server/.env and fill in real values.

GEMINI_API_KEY=your_gemini_api_key
PORT=5001
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your_app_password

# Stripe (required in production)
STRIPE_SECRET_KEY=sk_live_or_sk_test_key
STRIPE_PUBLIC_KEY=pk_live_or_pk_test_key
STRIPE_MONTHLY_PRICE_ID=price_monthly_id
STRIPE_ONE_TIME_PRICE_ID=price_one_time_id
STRIPE_WEBHOOK_SECRET=whsec_xxx

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=replace_with_strong_secret
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
